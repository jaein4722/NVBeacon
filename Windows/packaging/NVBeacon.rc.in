// Windows resources for NVBeacon.exe: icon and version information.
// scripts/package.ps1 fills in @VERSION@ / @VERSION_COMMAS@ and compiles this with rc.exe.
// The version's FileDescription is the name Windows shows on NVBeacon's notifications.
#include <winver.h>

1 ICON "NVBeacon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERSION_COMMAS@
 PRODUCTVERSION @VERSION_COMMAS@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "NVBeacon"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "@NAME@"
            VALUE "LegalCopyright", "Copyright (c) 2026 Lee Jaein. MIT License."
            VALUE "OriginalFilename", "@NAME@.exe"
            VALUE "ProductName", "NVBeacon"
            VALUE "ProductVersion", "@VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
